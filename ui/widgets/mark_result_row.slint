import { Icon } from "../components/icon.slint";
import { MarkRowItem } from "../structs/mark_row_item.slint";

export component MarkResultRow inherits Rectangle {
    in property <MarkRowItem> mark;
    in property <bool> is-current;
    callback activated();

    height: 56px;
    border-radius: 9px;
    border-width: root.is-current ? 1px : 0px;
    border-color: #89b6d2;
    background: root.is-current || touch.pressed ? #a5cfe6e8 : touch.has-hover ? #ffffff65 : transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 10px;
        Rectangle {
            width: 30px;
            horizontal-stretch: 0;
            Icon {
                icon-src: @image-url("../assets/window.svg");
                width-length: 30px;
                height-length: 30px;
                y: (parent.height - self.height) / 2;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.mark.title;
                font-size: 14px;
                font-weight: 400;
                color: #202720;
                overflow: elide;
                wrap: no-wrap;
            }
        }
        Rectangle {
            width: 32px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            background: #89bff0;
            border-color: #7eafe0;
            border-width: 1px;
            border-radius: 6px;
            Text {
                text: root.mark.slot;
                color: #36689a;
                font-size: 11px;
                font-weight: 400;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    touch := TouchArea { clicked => { root.activated(); } }
}
