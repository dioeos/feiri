import { MarkRowItem } from "../structs/mark_row_item.slint";

export component MarkResultRow {
  in property <MarkRowItem> mark;
  in property <bool> is-current;
  callback activated();

  height: 36px;

  Rectangle {
    height: 55px;
    border-radius: 9px;
    background: ta.pressed || root.is-current ? orange : transparent;

    animate background {
      duration: 100ms;
    }

    HorizontalLayout {
      padding-left: 10px;
      padding-right: 10px;
      spacing: 10px;

      VerticalLayout {
        alignment: center;
        spacing: 1px;
        Text {
          text: root.mark.title;
          font-weight: 600;
          color: #171717;
          overflow: elide;
        }
      }

      Rectangle {
        horizontal-stretch: 1;
      }

      // Text { text: root.mark.slot; }
      // Text {
      //   text: root.mark.title;
      //   horizontal-stretch: 1;
      //   overflow: elide;
      //   wrap: no-wrap;
      // }
    }

    ta := TouchArea {}
  }
}
